!tests/fixtures/**/*.tsv
!tests/fixtures/**/*.xls
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.zip

# Generated analytical storage
*.parquet
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
